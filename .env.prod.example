# ── flechettes — variables de production (à copier en `.env` sur le VPS) ─────
# cp .env.prod.example .env    puis :  docker compose up -d --build
#
# L'application n'a besoin d'aucun secret : pas de base de données, pas de
# compte. La partie en cours vit dans le volume Docker `state`.

TZ=Europe/Paris
